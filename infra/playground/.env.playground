# ─────────────────────────────────────────────────────────────────────────────
# NextGenDataHive — Local AWS Playground environment variables
# Load when starting the stack:  docker compose --env-file .env.playground up -d
# Load in your shell/IDE:        export $(grep -v '^#' .env.playground | xargs)
# ─────────────────────────────────────────────────────────────────────────────

# ── Fake AWS credentials (accepted by LocalStack and MinIO) ──────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Override boto3 to hit LocalStack instead of real AWS.
# In Python:  boto3.client("kinesis", endpoint_url=os.environ["AWS_ENDPOINT_URL"])
# boto3 also respects AWS_ENDPOINT_URL automatically in recent versions.
AWS_ENDPOINT_URL=http://localhost:4566

# boto3 S3 should hit MinIO for Iceberg-compatible object storage
AWS_S3_ENDPOINT_URL=http://localhost:9000

# ── MinIO (S3-compatible) ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Bucket names (created automatically by minio/init-minio.sh)
MINIO_BUCKET_ICEBERG=iceberg-warehouse
MINIO_BUCKET_RAW=raw-landing
MINIO_BUCKET_PROCESSED=processed

# ── LocalStack ───────────────────────────────────────────────────────────────
LOCALSTACK_PORT=4566

# Kinesis stream names (created by localstack/init-aws.sh)
KINESIS_STREAM_NAME=datahive-events
KINESIS_STREAM_SHARDS=1

# SQS queue names
SQS_QUEUE_NAME=datahive-dlq

# ── Project Nessie (Iceberg REST catalog) ────────────────────────────────────
NESSIE_PORT=19120
NESSIE_URI=http://localhost:19120/api/v2
NESSIE_ICEBERG_URI=http://localhost:19120/iceberg
NESSIE_DEFAULT_BRANCH=main

# ── Apache Spark (EMR simulation) ────────────────────────────────────────────
SPARK_MASTER_UI_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2

# ── AWS Glue Docker (JupyterLab) ─────────────────────────────────────────────
GLUE_JUPYTER_PORT=8888
# Connect to JupyterLab: http://localhost:8888?token=datahive
JUPYTER_TOKEN=datahive

# ─────────────────────────────────────────────────────────────────────────────
# NextGenDataHive API integration
# When running the DataHive API locally against this playground, load these
# vars so that connector_runtime.py AWS calls hit LocalStack/MinIO instead of
# real AWS endpoints.
# ─────────────────────────────────────────────────────────────────────────────
# Example: source .env.playground && python -m api
