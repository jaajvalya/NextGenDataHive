# Copy to `.env` and fill in real values. `.env` is git-ignored.

# MongoDB (connectors / connection_log / query_log / glossary_upload_log)
# DB path must match a database the Mongo user can access (authSource must match).
MONGO_URI=mongodb://<user>:<password>@localhost:27017/datahive?authSource=datahive
MONGO_COLLECTION=connector_dtls
MONGO_CONNECTION_LOGS_COLLECTION=connection_log
MONGO_QUERY_LOGS_COLLECTION=query_log
MONGO_GLOSSARY_UPLOAD_LOG_COLLECTION=glossary_upload_log
MONGO_ASSET_GLOSSARY_COLLECTION=asset_glossary

# Encrypts passwords/keys stored in connector_dtls (reversible for auth).
# Any long random string works. Changing it makes previously saved secrets unreadable.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DATAHIVE_SECRETS_KEY=change-me-to-a-long-random-secret

# PostgreSQL (Assets tab — bronze / silver / gold schemas)
# Must match the login you use in pgAdmin / psql.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<password>
POSTGRES_DATABASE=datahivepoc
# Preferred schemas first; Assets also auto-discovers other user schemas in this database.
POSTGRES_ASSET_SCHEMAS=dhpoc-bronze,dhpoc-silver,dhpoc-gold,bronze,silver,gold,public

# Or one connection string (special characters in password must be URL-encoded).
# Generated ETL scripts prefer this when set; otherwise they build from POSTGRES_* above.
# POSTGRES_CONNINFO=postgresql+psycopg://postgres:<password>@localhost:5432/datahivepoc

# Ask Aura tab (natural-language querying). Leave DATAHIVE_AI_PROVIDER=none to hide the tab.
# `auto` uses OpenAI when a key is present and is off otherwise; local models are opt-in.
#   openai  → set DATAHIVE_AI_API_KEY, e.g. DATAHIVE_AI_MODEL=gpt-4o-mini
#   ollama  → no key needed; run `ollama serve` and pull the model first
DATAHIVE_AI_PROVIDER=none
DATAHIVE_AI_MODEL=gpt-4o-mini
DATAHIVE_AI_API_KEY=
# Override for Azure OpenAI, a proxy, or a non-default Ollama host.
# DATAHIVE_AI_BASE_URL=https://api.openai.com/v1
DATAHIVE_AI_TIMEOUT=60
# Row cap applied to every generated query (a LIMIT is added when missing).
DATAHIVE_AI_MAX_ROWS=500
# false = never send result rows to the model; the UI shows the table without a written answer.
DATAHIVE_AI_SEND_RESULTS=true
